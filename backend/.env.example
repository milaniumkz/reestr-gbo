DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ersi_gbo?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace_with_64_hex_chars"
JWT_REFRESH_SECRET="replace_with_64_hex_chars"
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="/opt/reestr/storage"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="ersi-gbo"
S3_REGION="us-east-1"
S3_PUBLIC_URL="http://localhost/storage"
SMS_PROVIDER="http"
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
PAYMENT_PROVIDER="http"
PAYMENT_HTTP_URL=""
PAYMENT_HTTP_TOKEN=""
PAYMENT_WEBHOOK_SECRET="replace_with_64_hex_chars"
PUBLIC_API_URL="http://localhost/api/v1"
MEDIA_HLS_BASE_URL="http://localhost/media/hls"
STORAGE_ENCRYPTION_KEY="replace_with_64_hex_chars"

# auto: enable only when a server-side key is configured; required: block uploads without a key; off: explicitly disable.
PHOTO_MODERATION_MODE="auto"
OPENAI_API_KEY=""
PHOTO_MODERATION_MODEL="gpt-4.1-mini"
