generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  phone       String    @unique
  email       String?
  fullName    String
  residenceCity String?
  iin         String?
  isBlocked   Boolean   @default(false)
  passwordHash String @default("$2b$12$i.sS/wBAoDl.IRiJFeQjue1wpHeFFZ9dlER8f/EAmmreRVcVQAElq")
  mustChangePassword Boolean @default(true)
  passwordVersion Int @default(0)
  failedPasswordAttempts Int @default(0)
  passwordLockedUntil DateTime?
  passwordChangedAt DateTime?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bankInvoices BankInvoice[]
  roles       UserRole[]
  sessions    Session[]
  memberships OrganizationMember[]
  vehicles    VehicleOwner[]
  audits      AuditLog[]
  createdInspections  Inspection[] @relation("InspectionCreatedBy")
  submittedInspections Inspection[] @relation("InspectionSubmittedBy")
  approvedInspections Inspection[] @relation("InspectionApprovedBy")
  qualityReviewInspections Inspection[] @relation("InspectionQualityReviewer")
  qualityConfirmedInspections Inspection[] @relation("InspectionQualityConfirmedBy")
}

model UserRole {
  id     String @id @default(uuid())
  role   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  refreshHash String
  deviceName  String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpChallenge {
  id          String    @id @default(uuid())
  phone       String
  codeHash    String
  purpose     String    @default("login")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([phone, purpose, createdAt])
}

model Organization {
  id        String   @id @default(uuid())
  type      String
  name      String
  legalName String?
  billingNumber Int @unique @default(autoincrement())
  bin       String   @unique
  status    String   @default("active")
  address   String?
  region    String?
  contactPhone String?
  contactEmail String?
  accreditationValidFrom DateTime? @db.Date
  accreditationValidUntil DateTime? @db.Date
  lat       Decimal? @db.Decimal(9, 6)
  lng       Decimal? @db.Decimal(9, 6)
  rating    Decimal? @db.Decimal(3, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankInvoices BankInvoice[]
  members     OrganizationMember[]
  inspections Inspection[]
  cameras     Camera[]
  balances    Balance[]
  importJobs  CertificateImportJob[]
}

model Banner {
  id              String   @id @default(uuid())
  title           String
  linkUrl         String?
  objectKey       String
  durationSeconds Int      @default(5)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GboEquipmentItem {
  id        String   @id @default(uuid())
  type      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@index([type, isActive])
}

model LegalDocument {
  id        String   @id @default(uuid())
  title     String
  excerpt   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, role])
}

model Vehicle {
  id              String   @id @default(uuid())
  vin             String   @unique
  plateNumber     String
  normalizedPlate String?
  vinLast3        String?
  make            String
  model           String
  year            Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owners       VehicleOwner[]
  cylinders    GasCylinder[]
  inspections  Inspection[]
  certificates Certificate[]

  @@index([normalizedPlate, vinLast3])
}

model VehicleOwner {
  id        String  @id @default(uuid())
  vehicleId String
  userId    String?
  phone     String?
  iin       String?
  fullName  String
  address   String?
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model GasCylinder {
  fuelType        String?
  inspectedAt     DateTime?
  id              String    @id @default(uuid())
  vehicleId       String
  serialNumber    String
  manufacturer    String
  volumeLiters    Int
  reducerName     String?
  controlUnitName String?
  producedAt      DateTime?
  validUntil      DateTime
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Inspection {
  id                String            @id @default(uuid())
  organizationId    String
  vehicleId         String
  createdById       String?
  submittedById     String?
  approvedById      String?
  status            String            @default("draft")
  certificateNumber String?           @unique
  inspectorName     String?
  notes             String?
  lat               Float?
  lng               Float?
  address           String?
  autoPublishAt     DateTime?
  submittedAt       DateTime?
  qualityDocumentUploadedAt DateTime?
  qualityConfirmedAt DateTime?
  requireApplicantPhotos Boolean @default(false)
  qualityReviewerId String?
  qualityReviewStartedAt DateTime?
  qualityConfirmedById String?
  approvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id])
  vehicle           Vehicle           @relation(fields: [vehicleId], references: [id])
  createdBy         User?             @relation("InspectionCreatedBy", fields: [createdById], references: [id])
  submittedBy       User?             @relation("InspectionSubmittedBy", fields: [submittedById], references: [id])
  qualityReviewer User? @relation("InspectionQualityReviewer", fields: [qualityReviewerId], references: [id], onDelete: SetNull)
  qualityConfirmedBy User? @relation("InspectionQualityConfirmedBy", fields: [qualityConfirmedById], references: [id], onDelete: SetNull)
  approvedBy        User?             @relation("InspectionApprovedBy", fields: [approvedById], references: [id])
  photos            InspectionPhoto[]
  certificate       Certificate?
}

model InspectionPhoto {
  id           String     @id @default(uuid())
  inspectionId String
  type         String
  objectKey    String
  moderationStatus String @default("not_checked")
  moderationModel String?
  moderationCheckedAt DateTime?
  moderationReason String?
  checksum     String?
  lat          Float?
  lng          Float?
  createdAt    DateTime   @default(now())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model Certificate {
  id           String                 @id @default(uuid())
  number       String                 @unique
  vehicleId    String
  inspectionId String                 @unique
  status       String                 @default("active")
  qrPayload    String
  pdfObjectKey String?
  validUntil   DateTime
  issuedAt     DateTime               @default(now())
  vehicle      Vehicle                @relation(fields: [vehicleId], references: [id])
  inspection   Inspection             @relation(fields: [inspectionId], references: [id])
  views        CertificateView[]
  imports      CertificateImportJob[]
}

model CertificateView {
  id            String      @id @default(uuid())
  certificateId String
  viewerIp      String?
  createdAt     DateTime    @default(now())
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
}

model PublicCertificateCheck {
  id                String   @id @default(uuid())
  plateNumber       String
  normalizedPlate   String
  vinLast3          String
  found             Boolean  @default(false)
  vehicleId         String?
  certificateId     String?
  certificateNumber String?
  lat               Float?
  lng               Float?
  address           String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([found, createdAt])
  @@index([normalizedPlate, vinLast3])
  @@index([certificateNumber])
}

model Payment {
  id             String   @id @default(uuid())
  organizationId String?
  provider       String
  externalId     String?
  amount         Int
  currency       String   @default("KZT")
  status         String   @default("pending")
  purpose        String
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StorageObject {
  id          String   @id @default(uuid())
  objectKey   String   @unique
  bucket      String
  contentType String?
  sizeBytes   Int
  checksum    String?
  createdById String?
  createdAt   DateTime @default(now())
}

model CertificateImportJob {
  id             String                   @id @default(uuid())
  status         String                   @default("pending")
  filename       String
  objectKey      String
  fileHash       String
  organizationId String?
  certificateId  String?
  createdById    String?
  createdCount   Int                      @default(0)
  updatedCount   Int                      @default(0)
  skippedCount   Int                      @default(0)
  errorCount     Int                      @default(0)
  summary        Json?
  createdAt      DateTime                 @default(now())
  finishedAt     DateTime?
  certificate    Certificate?             @relation(fields: [certificateId], references: [id])
  organization   Organization?            @relation(fields: [organizationId], references: [id])
  errors         CertificateImportError[]

  @@unique([fileHash, filename])
  @@index([status, createdAt])
}

model CertificateImportError {
  id        String               @id @default(uuid())
  jobId     String
  field     String?
  message   String
  rawValue  String?
  createdAt DateTime             @default(now())
  job       CertificateImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Tariff {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  amount     Int
  currency   String   @default("KZT")
  periodDays Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Balance {
  id             String       @id @default(uuid())
  organizationId String
  amount         Int          @default(0)
  currency       String       @default("KZT")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
}

model Camera {
  id               String          @id @default(uuid())
  organizationId   String
  name             String
  rtspUrlEncrypted String
  status           String          @default("active")
  hlsPath          String?
  createdAt        DateTime        @default(now())
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions         CameraSession[]
}

model CameraSession {
  id        String    @id @default(uuid())
  cameraId  String
  status    String    @default("live")
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  events    Json?
  camera    Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
}

model ApiToken {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  tokenHash      String
  scopes         String[]
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
}

model Notification {
  dedupKey String? @unique
  organizationId String?
  entity String?
  entityId String?
  id        String    @id @default(uuid())
  userId    String?
  role      String?
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  requestId String?
  sessionId String?
  appVersion String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}

model TechAccount {
id String @id @default(uuid())
login String @unique
fullName String
role String
permissions String[] @default([])
passwordHash String
totpEncrypted String?
totpConfirmedAt DateTime?
lastTotpStep Int @default(-1)
passwordChangedAt DateTime @default(now())
version Int @default(0)
active Boolean @default(true)
failedAttempts Int @default(0)
lockedUntil DateTime?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
sessions TechSession[]
}

model TechSession {
id String @id @default(uuid())
tokenHash String @unique
accountId String
account TechAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
version Int
mfaVerified Boolean @default(false)
expiresAt DateTime
idleExpiresAt DateTime
reauthenticatedUntil DateTime?
revokedAt DateTime?
createdAt DateTime @default(now())
@@index([accountId,revokedAt])
}

model TechnicalPushSubscription {
id String @id @default(uuid())
accountId String
endpoint String @unique
p256dh String
auth String
createdAt DateTime @default(now())
lastSuccessAt DateTime?
lastAttemptAt DateTime?
lastError String?
active Boolean @default(true)
@@index([accountId,active])
}

model TechnicalPushDelivery {
subscriptionId String
alertId String
state String @default("pending")
attempts Int @default(0)
nextAttemptAt DateTime @default(now())
lastError String?
sentAt DateTime?
@@id([subscriptionId,alertId])
}

model InspectionDeviation {
id String @id @default(uuid())
dedupKey String @unique
inspectionId String
kind String
severity String @default("warning")
explanation String
facts Json
status String @default("new")
firstSeenAt DateTime @default(now())
lastSeenAt DateTime @default(now())
reviewedBy String?
reviewedAt DateTime?
reviewNote String?
@@index([inspectionId])
@@index([status,lastSeenAt])
}

model TechnicalEvent {
id String @id @default(uuid())
createdAt DateTime @default(now())
source String
category String
action String
result String
severity String @default("info")
requestId String?
actorId String?
actorRole String?
techActorId String?
sessionId String?
objectType String?
objectId String?
explanation String
details Json?
ipAddress String?
device String?
appVersion String?
location Json?
problemId String?
expiresAt DateTime
holdUntil DateTime?
@@index([createdAt,id])
@@index([category,createdAt])
@@index([requestId])
@@index([problemId,createdAt])
@@index([actorId,createdAt])
@@index([expiresAt])
}

model TechnicalProblem {
id String @id @default(uuid())
fingerprint String @unique
title String
severity String
status String @default("new")
source String
code String
route String
firstSeenAt DateTime @default(now())
lastSeenAt DateTime @default(now())
occurrences Int @default(1)
assignedTo String?
resolvedVersion String?
verificationMethod String?
verificationResult String?
verifiedAt DateTime?
lastRequestId String?
details Json?
comments TechnicalComment[]
}

model TechnicalComment {
id String @id @default(uuid())
problemId String
problem TechnicalProblem @relation(fields:[problemId],references:[id],onDelete:Cascade)
accountId String
note String
kind String @default("comment")
createdAt DateTime @default(now())
}

model TechnicalAlert {
id String @id @default(uuid())
dedupKey String @unique
title String
explanation String
severity String
category String
problemId String?
repetitions Int @default(1)
firstSeenAt DateTime @default(now())
lastSeenAt DateTime @default(now())
acknowledgedBy String?
acknowledgedAt DateTime?
assignedTo String?
mutedUntil DateTime?
muteReason String?
}

model TechnicalRule {
category String @id
enabled Boolean @default(true)
threshold Int @default(5)
windowMinutes Int @default(15)
cooldownMinutes Int @default(30)
quietStart Int?
quietEnd Int?
recipients String[] @default(["owner","engineer"])
updatedAt DateTime @updatedAt
}

model TechnicalSetting {
key String @id
value Json
updatedBy String
reason String
updatedAt DateTime @updatedAt
}

model TechnicalSnapshot {
key String @id
source String
value Json
observedAt DateTime
expiresAt DateTime
}

model PasswordRecovery {
id String @id @default(uuid())
tokenHash String @unique
userId String
issuedBy String
reason String
expiresAt DateTime
usedAt DateTime?
createdAt DateTime @default(now())
@@index([userId,createdAt])
}

model TechnicalRateLimit {
key String @id
count Int @default(1)
expiresAt DateTime
@@index([expiresAt])
}

model PasswordRecoveryRequest {
  id String @id @default(uuid())
  userId String
  organizationId String
  status String @default("pending")
  approvedBy String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([organizationId, status, createdAt])
  @@index([userId, status])
}

model BankInvoice {
  id String @id @default(uuid())
  number Int @unique @default(autoincrement())
  organizationId String?
  issuedById String?
  requestKey String
  amountMinor BigInt
  currency String @default("KZT")
  status String @default("issued")
  snapshot Json
  pdf Bytes
  createdAt DateTime @default(now())
  organization Organization? @relation(fields:[organizationId],references:[id],onDelete:SetNull)
  issuedBy User? @relation(fields:[issuedById],references:[id],onDelete:SetNull)
  @@unique([organizationId,requestKey])
  @@index([organizationId,createdAt])
}
